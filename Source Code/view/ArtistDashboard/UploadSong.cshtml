@model SpotifyClone.Features.ArtistDashboard.ViewModels.UploadSongViewModel
@{
    ViewData["Title"] = "Đăng bài hát";
    ViewData["ActiveMenu"] = "upload";
}
<div class="card form-card">
    <h2 class="card-title">Đăng bài hát mới</h2>
    <p style="color:var(--text-muted); font-size:13px; margin-top:-8px; margin-bottom:20px;">
        Bài hát sau khi gửi sẽ ở trạng thái <strong style="color:#ffc107;">Pending</strong> — chờ Admin duyệt trước khi hiển thị công khai.
    </p>
    <form asp-action="UploadSong" method="post" id="uploadSongForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="Duration" type="hidden" id="durationInput" />
        <div class="form-group">
            <label asp-for="Title">Tên bài hát</label>
            <input asp-for="Title" class="form-control" placeholder="Nhập tên bài hát" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="AudioURL">Link file nhạc (URL)</label>
            <input asp-for="AudioURL" class="form-control" placeholder="https://..." id="audioUrlInput" />
            <span asp-validation-for="AudioURL" class="text-danger"></span>
            <span id="durationPreview" style="display:block;margin-top:6px;font-size:13px;color:var(--text-muted);"></span>
            <span asp-validation-for="Duration" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="CoverImage">Link ảnh bìa (URL, tuỳ chọn)</label>
            <input asp-for="CoverImage" class="form-control" placeholder="https://..." />
            <span asp-validation-for="CoverImage" class="text-danger"></span>
        </div>
        <div class="form-group" style="display:flex;align-items:flex-start;gap:8px;">
            <input asp-for="IsPremium" type="checkbox" style="margin-top:4px;width:16px;height:16px;" />
            <label asp-for="IsPremium" style="margin:0;cursor:pointer;">
                Bài hát chỉ dành cho Premium
                <span style="display:block;font-size:12px;color:var(--text-muted);font-weight:400;">
                    Nếu tích chọn, người dùng chưa đăng ký Premium chỉ nghe được 30% thời lượng bài hát, sau đó sẽ được mời nâng cấp Premium để nghe trọn vẹn.
                </span>
            </label>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-primary" id="submitBtn">Gửi bài hát</button>
            <a asp-action="Index" class="btn-cancel">Huỷ</a>
        </div>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const audioUrlInput = document.getElementById('audioUrlInput');
        const durationInput = document.getElementById('durationInput');
        const durationPreview = document.getElementById('durationPreview');
        const submitBtn = document.getElementById('submitBtn');
        function formatDuration(totalSeconds) {
            const m = Math.floor(totalSeconds / 60);
            const s = Math.floor(totalSeconds % 60);
            return m + ':' + String(s).padStart(2, '0');
        }
        audioUrlInput.addEventListener('blur', function() {
            const url = audioUrlInput.value.trim();
            if (!url) {
                durationPreview.textContent = '';
                durationInput.value = '';
                return;
            }
            durationPreview.textContent = 'Đang lấy thời lượng bài hát...';
            submitBtn.disabled = true;
            const audio = new Audio();
            audio.src = url;
            audio.addEventListener('loadedmetadata', function() {
                const seconds = Math.round(audio.duration);
                durationInput.value = seconds;
                durationPreview.textContent = 'Thời lượng: ' + formatDuration(seconds);
                submitBtn.disabled = false;
            });
            audio.addEventListener('error', function() {
                durationPreview.textContent = 'Không đọc được thời lượng từ link này. Vui lòng kiểm tra lại link file nhạc.';
                durationInput.value = '';
                submitBtn.disabled = false;
            });
        });
    </script>
}
