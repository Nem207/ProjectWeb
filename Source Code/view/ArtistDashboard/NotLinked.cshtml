@model SpotifyClone.Features.ArtistDashboard.ViewModels.ArtistDashboardViewModel
@{
    ViewData["Title"] = "Artist Dashboard";
}
<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        @if (!string.IsNullOrEmpty(Model.Avatar))
        {
            <img src="@Model.Avatar" class="rounded-circle me-3" width="64" height="64" alt="@Model.ArtistName" />
        }
        <h2 class="mb-0">@Model.ArtistName</h2>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card p-3 text-center">
                <div class="fs-4 fw-bold">@Model.TotalSongs</div>
                <div class="text-muted">Bài hát</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 text-center">
                <div class="fs-4 fw-bold">@Model.TotalPlays.ToString("N0")</div>
                <div class="text-muted">Lượt nghe</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 text-center">
                <div class="fs-4 fw-bold">@Model.TotalLikes.ToString("N0")</div>
                <div class="text-muted">Lượt thích</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 text-center">
                <div class="fs-4 fw-bold">@Model.TotalFollowers.ToString("N0")</div>
                <div class="text-muted">Người theo dõi</div>
            </div>
        </div>
    </div>
    <h4>Top bài hát</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Bài hát</th>
                <th>Trạng thái</th>
                <th>Lượt nghe</th>
                <th>Lượt thích</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var song in Model.TopSongs)
            {
                <tr>
                    <td>@song.Title</td>
                    <td>@song.Status</td>
                    <td>@song.TotalPlays.ToString("N0")</td>
                    <td>@song.TotalLikes.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
