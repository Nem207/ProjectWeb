@using System.Security.Claims
@{
    var headerAvatarUrl = User.FindFirst("AvatarUrl")?.Value;
}
<header class="topbar">
    <div class="topbar-nav">
        <button class="sidebar-toggle-mobile" id="sidebarToggleMobile" aria-label="Mở menu" type="button">
            <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                <path d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z" />
            </svg>
        </button>
    </div>
    <form class="topbar-search"
          id="topbarSearch"
          asp-controller="Search"
          asp-action="Index"
          method="get">
        <div class="topbar-search-icon">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5A6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5ZM9.5 14C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14Z" />
            </svg>
        </div>
        <input type="search"
               id="searchInput"
               name="keyword"
               placeholder="Bạn muốn nghe gì?"
               autocomplete="off" />
        <div class="search-results" id="searchResults"></div>
    </form>
    <div class="topbar-user">
        @await Component.InvokeAsync("PremiumStatus")
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="user-avatar-btn"
                    id="userAvatarBtn"
                    onclick="toggleUserDropdown(event)"
                    style="width:36px;height:36px;min-width:36px;min-height:36px;max-width:36px;max-height:36px;flex-shrink:0;border-radius:50%;overflow:hidden;display:flex;align-items:center;justify-content:center;padding:0;">
                @if (!string.IsNullOrWhiteSpace(headerAvatarUrl))
                {
                    <img src="@headerAvatarUrl"
                         id="userAvatarImg"
                         alt="Avatar"
                         style="width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;"
                         onerror="this.style.display='none';document.getElementById('userInitial').style.display='flex';" />
                    <span id="userInitial"
                          style="display:none;width:100%;height:100%;align-items:center;justify-content:center;">
                        @(string.IsNullOrWhiteSpace(User.Identity?.Name)
                            ? "U"
                            : User.Identity.Name.Substring(0, 1).ToUpper())
                    </span>
                }
                else
                {
                    <span id="userInitial"
                          style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
                        @(string.IsNullOrWhiteSpace(User.Identity?.Name)
                            ? "U"
                            : User.Identity.Name.Substring(0, 1).ToUpper())
                    </span>
                }
            </button>
            <div class="user-dropdown" id="userDropdown">
                <div class="dropdown-item"
                     id="dropdownUsername"
                     style="font-weight:700;color:var(--color-text-secondary);font-size:13px;cursor:default;">
                    @User.Identity?.Name
                </div>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item"
                   asp-controller="Profile"
                   asp-action="Index"
                   onclick="closeUserDropdown()">
                    <svg viewBox="0 0 24 24"
                         width="16"
                         height="16"
                         fill="currentColor">
                        <path d="M12 12c2.21 0 4-1.79 4-4S14.21 4 12 4 8 5.79 8 8s1.79 4 4 4Zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4Z" />
                    </svg>
                    Tài khoản của tôi
                </a>
                <a class="dropdown-item"
                   id="adminMenuLink"
                   href="admin.html"
                   style="display:none;color:#1DB954;">
                    <svg viewBox="0 0 24 24"
                         width="16"
                         height="16"
                         fill="currentColor">
                        <path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4Zm0 4 5 2.18V11c0 3.5-2.33 6.79-5 7.93C9.33 17.79 7 14.5 7 11V7.18L12 5Z" />
                    </svg>
                    Quản lý Admin
                </a>
                <div class="dropdown-divider"></div>
                <form asp-controller="Auth"
                      asp-action="Logout"
                      method="post"
                      style="margin:0;">
                    <button type="submit"
                            class="dropdown-item"
                            style="width:100%;text-align:left;background:none;border:none;cursor:pointer;font:inherit;color:inherit;">
                        <svg viewBox="0 0 24 24"
                             width="16"
                             height="16"
                             fill="currentColor">
                            <path d="M17 7 15.59 8.41 18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5-5-5ZM4 5h8V3H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8v-2H4V5Z" />
                        </svg>
                        Đăng xuất
                    </button>
                </form>
            </div>
        }
        else
        {
            <a class="btn-login-topbar"
               asp-controller="Auth"
               asp-action="Login">
                Đăng nhập
            </a>
        }
    </div>
</header>
<script>
    function toggleUserDropdown(event) {
        event.stopPropagation();
        const dropdown = document.getElementById("userDropdown");
        if (dropdown) {
            dropdown.classList.toggle("open");
        }
    }
    function closeUserDropdown() {
        const dropdown = document.getElementById("userDropdown");
        if (dropdown) {
            dropdown.classList.remove("open");
        }
    }
    document.addEventListener("click", function (event) {
        const dropdown = document.getElementById("userDropdown");
        const avatarBtn = document.getElementById("userAvatarBtn");
        if (!dropdown || !dropdown.classList.contains("open"))
            return;
        if (dropdown.contains(event.target))
            return;
        if (avatarBtn && avatarBtn.contains(event.target))
            return;
        dropdown.classList.remove("open");
    });
    (function () {
        const mainContent = document.getElementById("mainContent");
        const topbar = document.querySelector(".topbar");
        if (!mainContent || !topbar)
            return;
        const SCROLL_THRESHOLD = 60;
        function updateTopbarBackground() {
            if (mainContent.scrollTop > SCROLL_THRESHOLD) {
                topbar.classList.add("scrolled");
            }
            else {
                topbar.classList.remove("scrolled");
            }
        }
        mainContent.addEventListener("scroll", updateTopbarBackground, {
            passive: true
        });
        updateTopbarBackground();
    })();
</script>
